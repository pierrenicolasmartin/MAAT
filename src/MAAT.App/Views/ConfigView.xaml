<UserControl x:Class="MAAT.App.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MAAT.App.Converters"
             xmlns:ui="clr-namespace:MAAT.App.Controls"
             xmlns:l="clr-namespace:MAAT.App.Localization">
    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />

        <!-- Libellé de champ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Section}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- Titre et description d'une carte de choix -->
        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ChoiceText" TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="24,20,24,24">
        <!-- ── Dossier à auditer ── -->
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Cfg_Folder}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Padding="34,0,10,0" MinHeight="36" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                         Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Folder}" HorizontalAlignment="Left" Margin="11,0,0,0"
                                Foreground="{DynamicResource TertiaryBrush}" IsHitTestVisible="False" />
            </Grid>
            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" MinHeight="36"
                    Content="{l:Loc Cfg_Browse}" Command="{Binding BrowseCommand}" />
        </Grid>
        <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" Text="{l:Loc Cfg_FolderHint}" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasPathError, Converter={StaticResource BoolToVis}}">
            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Alert}" Width="14" Height="14"
                            Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" />
            <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding PathError}" />
        </StackPanel>

        <!-- ── Contenu ── -->
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Cfg_Content}" Margin="0,22,0,8" />
        <UniformGrid Columns="3">
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="content" Margin="0,0,6,0"
                         IsChecked="{Binding Content, Converter={StaticResource EnumMatch}, ConverterParameter=RightsOnly}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ChoiceTitle}" Text="{l:Loc Cfg_ContentRights}" />
                    <TextBlock Style="{StaticResource ChoiceText}" Text="{l:Loc Cfg_ContentRightsDesc}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="content" Margin="3,0,3,0"
                         IsChecked="{Binding Content, Converter={StaticResource EnumMatch}, ConverterParameter=SizeOnly}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ChoiceTitle}" Text="{l:Loc Cfg_ContentSize}" />
                    <TextBlock Style="{StaticResource ChoiceText}" Text="{l:Loc Cfg_ContentSizeDesc}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="content" Margin="6,0,0,0"
                         IsChecked="{Binding Content, Converter={StaticResource EnumMatch}, ConverterParameter=RightsAndSize}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ChoiceTitle}" Text="{l:Loc Cfg_ContentBoth}" />
                    <TextBlock Style="{StaticResource ChoiceText}" Text="{l:Loc Cfg_ContentBothDesc}" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- ── Éléments + profondeur ── -->
        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Cfg_Type}" />
                <UniformGrid Columns="2">
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="scope" Margin="0,0,6,0"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumMatch}, ConverterParameter=FoldersOnly}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ChoiceTitle}" Text="{l:Loc Cfg_TypeFolders}" />
                            <TextBlock Style="{StaticResource ChoiceText}" Text="{l:Loc Cfg_TypeFoldersDesc}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="scope" Margin="6,0,0,0"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumMatch}, ConverterParameter=FoldersAndFiles}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ChoiceTitle}" Text="{l:Loc Cfg_TypeFiles}" />
                            <TextBlock Style="{StaticResource ChoiceText}" Text="{l:Loc Cfg_LongHint}" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Cfg_Depth}" />
                <ComboBox ItemsSource="{Binding DepthOptions}" SelectedItem="{Binding SelectedDepth}" Height="36">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{l:Loc Cfg_DepthHint}" />
            </StackPanel>
        </Grid>

        <!-- ── Identités ── -->
        <Border Margin="0,22,0,0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12" IsEnabled="{Binding AuditsRights}">
            <StackPanel>
                <CheckBox IsChecked="{Binding IncludeLocalAccounts}">
                    <TextBlock Text="{l:Loc Cfg_IncludeLocal}" FontWeight="SemiBold" />
                </CheckBox>
                <TextBlock Style="{StaticResource T.Caption}" Margin="26,4,0,0" TextWrapping="Wrap"
                           Text="{l:Loc Cfg_IncludeLocalHint}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
