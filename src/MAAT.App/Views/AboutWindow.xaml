<Window x:Class="MAAT.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MAAT.App.Localization"
        Title="{l:Loc About_WinTitle}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/MAAT.App;component/Assets/maat.ico"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="FactLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- ═════════ Identité du produit ═════════ -->
        <Grid Margin="28,26,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Top">
                <Image Source="{DynamicResource LogoSymbolImage}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,2,0,0">
                <TextBlock Text="MAÂT" Style="{StaticResource T.PageTitle}" FontSize="22" />
                <TextBlock Text="{l:Loc About_Subtitle}" Style="{StaticResource T.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ContentControl x:Name="VersionBadge" Style="{StaticResource Badge.Accent}" />
                    <ContentControl Style="{StaticResource Badge}" Content="{l:Loc About_Edition}" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═════════ Description + faits ═════════ -->
        <StackPanel Margin="28,20,28,24">
            <TextBlock Text="{l:Loc About_Tagline}" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource MutedBrush}" />

            <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                <StackPanel Margin="16,0">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FactLabel}" Text="{l:Loc About_Cap1Label}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FactValue}" Text="{l:Loc About_Cap1Value}" />
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FactLabel}" Text="{l:Loc About_Cap2Label}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FactValue}" Text="{l:Loc About_Cap2Value}" />
                        </Grid>
                    </Border>
                    <Border Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FactLabel}" Text="{l:Loc About_Cap3Label}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FactValue}" Text="{l:Loc About_Cap3Value}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Licence -->
            <ContentControl Style="{StaticResource Callout}" Tag="{StaticResource Ico.ShieldCheck}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{l:Loc About_License}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource MutedBrush}">
                        <Run Text="{l:Loc About_LicenseBody}" /><Hyperlink
                            NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html" RequestNavigate="OnNavigate"
                            Foreground="{DynamicResource AccentTextBrush}">www.gnu.org/licenses/gpl-3.0.html</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource T.Caption}" TextWrapping="Wrap" LineHeight="17"
                               Text="{l:Loc About_Warranty}" />
                </StackPanel>
            </ContentControl>
        </StackPanel>

        <!-- ═════════ Pied ═════════ -->
        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12">
            <Grid>
                <TextBlock x:Name="CopyrightText" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Content="{l:Loc Common_Close}" MinWidth="96"
                        IsCancel="True" IsDefault="True" Click="OnClose" />
            </Grid>
        </Border>
    </StackPanel>
</Window>
