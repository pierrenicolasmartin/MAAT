<Window x:Class="MAAT.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MAAT.App.Localization"
        Title="{l:Loc Prog_Title}"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/MAAT.App;component/Assets/maat.ico"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <DockPanel>
        <!-- Pied : minuteur + annulation -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Clock}" Width="14" Height="14"
                                    Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding TimingText}" Style="{StaticResource T.Caption}" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Secondary}"
                        Content="{l:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
            </Grid>
        </Border>

        <StackPanel Margin="24,22,24,20">
            <!-- En-tête : titre + chemin / pourcentage -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Prog_Title}" Style="{StaticResource T.Title}" FontSize="18" />
                    <TextBlock Text="{Binding RootPath}" ToolTip="{Binding RootPath}" Style="{StaticResource T.MonoMuted}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,0" Style="{StaticResource T.Metric}" FontSize="24">
                    <Run Text="{Binding GlobalPercentNumber, Mode=OneWay}" /><Run Text=" %" Foreground="{DynamicResource TertiaryBrush}" FontSize="16" />
                </TextBlock>
            </Grid>

            <ProgressBar Margin="0,14,0,20" Value="{Binding GlobalPercent, Mode=OneWay}" />

            <!-- Étapes -->
            <Border Style="{StaticResource Panel}">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="rowBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Indicateur d'état -->
                                    <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Ellipse x:Name="pending" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5" />
                                        <Grid x:Name="active" Visibility="Collapsed">
                                            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" />
                                        </Grid>
                                        <ContentControl x:Name="done" Style="{StaticResource Icon}" Tag="{StaticResource Ico.CheckCircle}"
                                                        Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <TextBlock x:Name="lbl" Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="statusTb" HorizontalAlignment="Right" Text="{Binding RightStatus}"
                                                       Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="countTb" HorizontalAlignment="Right" Visibility="Collapsed" Text="{Binding CountText}"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar x:Name="sub" Height="4" Margin="0,9,0,0" Visibility="Collapsed"
                                                     Value="{Binding StepPercent, Mode=OneWay}"
                                                     IsIndeterminate="{Binding StepIndeterminate, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Première étape : pas de filet supérieur -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter TargetName="rowBorder" Property="BorderThickness" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="pending" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="active" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="statusTb" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="countTb" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="sub" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="pending" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="done" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
