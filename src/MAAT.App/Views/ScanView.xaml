<UserControl x:Class="MAAT.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MAAT.App.ViewModels"
             xmlns:beh="clr-namespace:MAAT.App.Behaviors"
             xmlns:ui="clr-namespace:MAAT.App.Controls"
             xmlns:l="clr-namespace:MAAT.App.Localization">
    <UserControl.Resources>
        <!-- Indicateur (valeur + libellé) du bandeau de l'espace de travail -->
        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Type d'ACE : pastille Autoriser (succès) / Refuser (danger) -->
        <Style x:Key="AceTypeBadge" TargetType="ContentControl" BasedOn="{StaticResource Badge.Success}">
            <Setter Property="Tag" Value="{StaticResource Ico.Check}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeny}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="Tag" Value="{StaticResource Ico.Ban}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Étiquette discrète d'un nœud (DFS / LIEN) -->
        <Style x:Key="NodeTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,0,4,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Surface3Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Ligne de liste sélectionnable (identités) -->
        <Style x:Key="IdentityItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Margin="8,1" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Surface3Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Encart d'état d'un élément (avertissement ambre / information neutre) -->
        <DataTemplate x:Key="StateCallout">
            <ContentControl Margin="0,0,0,8">
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Callout}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                <Setter Property="Tag" Value="{StaticResource Ico.Alert}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="18" />
                </StackPanel>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═════════ En-tête de l'espace de travail ═════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,18,24,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Top">
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Folder}" Width="20" Height="20" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RootName}" Style="{StaticResource T.PageTitle}" FontSize="19" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RootPath}" ToolTip="{Binding RootPath}" Style="{StaticResource T.MonoMuted}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TertiaryBrush}">
                            <Run Text="{l:Loc Scan_AuditedPrefix}" Foreground="{DynamicResource TertiaryBrush}" FontSize="12" />
                            <Run Text="{Binding AuditDateText, Mode=OneWay}" Foreground="{DynamicResource TertiaryBrush}" FontSize="12" />
                            <Run Text="   ·   " Foreground="{DynamicResource BorderStrongBrush}" />
                            <Run Text="{Binding ParametersText, Mode=OneWay}" Foreground="{DynamicResource TertiaryBrush}" FontSize="12" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Secondary}" Content="{l:Loc Ws_ReportBtn}" ui:Ui.Icon="{StaticResource Ico.Report}"
                                Click="OnReportClick" />
                        <Button Style="{StaticResource Btn.Secondary}" Content="{l:Loc Ws_Save}" ui:Ui.Icon="{StaticResource Ico.Save}"
                                Margin="8,0,0,0" Command="{Binding SaveProjectCommand}" />
                        <Button x:Name="ExportButton" Content="{l:Loc Ws_Export}" ui:Ui.Icon="{StaticResource Ico.Download}"
                                Margin="8,0,0,0" Click="OnExportClick">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="{l:Loc Menu_ExportHtml}" Command="{Binding ExportHtmlCommand}" />
                                    <MenuItem Header="{l:Loc Menu_ExportCsv}" Command="{Binding ExportCsvCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Indicateurs -->
                <WrapPanel Margin="54,14,0,0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{l:Loc Scan_Folders}" />
                        <TextBlock Style="{StaticResource T.Metric}" Text="{Binding StatFolders}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0" Visibility="{Binding ShowFilesStat, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{l:Loc Scan_Files}" />
                        <TextBlock Style="{StaticResource T.Metric}" Text="{Binding StatFiles}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0" Visibility="{Binding ShowSizeStat, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{l:Loc Scan_TotalSize}" />
                        <TextBlock Style="{StaticResource T.Metric}" Text="{Binding StatSizeText}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0" Visibility="{Binding ShowRightsStat, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{l:Loc Scan_Aces}" />
                        <TextBlock Style="{StaticResource T.Metric}" Text="{Binding StatAces}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0" Visibility="{Binding ShowRightsStat, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{l:Loc Scan_Identities}" />
                        <TextBlock Style="{StaticResource T.Metric}" Text="{Binding StatIdentities}" />
                    </StackPanel>
                    <!-- Complétude : ouvre le rapport d'analyse -->
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{l:Loc Ws_Coverage}" />
                        <Button Click="OnReportClick" Cursor="Hand" Margin="-6,1,0,0" ToolTip="{l:Loc Ws_CoverageTip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Subtle}">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="6,0,8,0" />
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Setter Property="ui:Ui.Icon" Value="{StaticResource Ico.CheckCircle}" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Setter Property="ui:Ui.Icon" Value="{StaticResource Ico.Alert}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <Binding Path="CompletenessText" />
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═════════ Barre d'outils ═════════ -->
        <Border Grid.Row="1" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,10">
            <DockPanel LastChildFill="False">
                <!-- Vue Dossiers / Identités -->
                <Border DockPanel.Dock="Left" Style="{StaticResource Seg.Track}" Margin="0,0,12,0"
                        Visibility="{Binding ShowRightsStat, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Seg.Button}" Content="{l:Loc Scan_SegFolders}" ui:Ui.Icon="{StaticResource Ico.Folder}"
                                Tag="{Binding IsFoldersView}" Command="{Binding ShowFoldersCommand}" />
                        <Button Style="{StaticResource Seg.Button}" Content="{l:Loc Scan_SegIdentities}" ui:Ui.Icon="{StaticResource Ico.Users}"
                                Tag="{Binding IsIdentitiesView}" Command="{Binding ShowIdentitiesCommand}" Margin="2,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Recherche -->
                <Border DockPanel.Dock="Left" Width="360" Height="32" CornerRadius="6" BorderThickness="1" Padding="10,0"
                        Background="{DynamicResource SurfaceBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource TertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Search}" Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,8,0" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            <TextBlock Text="{Binding SearchPlaceholder}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border Grid.Column="2" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource TertiaryBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Filtre des droits -->
                <ComboBox DockPanel.Dock="Left" Margin="12,0,0,0" Width="170"
                          SelectedValuePath="Tag" SelectedValue="{Binding SelectedAclFilter}"
                          Visibility="{Binding ShowRightsStat, Converter={StaticResource BoolToVis}}">
                    <ComboBoxItem Content="{l:Loc Scan_AllRights}" Tag="{x:Static vm:AclFilter.All}" />
                    <ComboBoxItem Content="{l:Loc Scan_Explicit}" Tag="{x:Static vm:AclFilter.Explicit}" />
                    <ComboBoxItem Content="{l:Loc Scan_Inherited}" Tag="{x:Static vm:AclFilter.Inherited}" />
                </ComboBox>
            </DockPanel>
        </Border>

        <!-- ═════════ Corps : maître-détail ═════════ -->
        <Grid Grid.Row="2">
            <!-- ───── Vue Dossiers ───── -->
            <Grid Visibility="{Binding IsFoldersView, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FoldersPaneColumn" Width="340" MinWidth="240" MaxWidth="640" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Maître : arbre -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                    <TreeView ItemsSource="{Binding Nodes}" BorderThickness="0" Background="Transparent" Padding="6,8"
                              SelectedItemChanged="OnTreeSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              FocusVisualStyle="{x:Null}">
                        <TreeView.Resources>
                            <Style x:Key="ExpandToggle" TargetType="ToggleButton">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="ClickMode" Value="Press" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Width="20" Height="28">
                                                <ContentControl x:Name="chev" Style="{StaticResource Icon}" Tag="{StaticResource Ico.ChevronRight}"
                                                                Width="14" Height="14" Foreground="{DynamicResource TertiaryBrush}"
                                                                RenderTransformOrigin="0.5,0.5" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="chev" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <DataTemplate DataType="{x:Type vm:LoadingPlaceholder}">
                                <TextBlock Style="{StaticResource T.Caption}" Text="{l:Loc Scan_Loading}" Margin="8,5" />
                            </DataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                <Grid Height="28" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Pictogramme : dossier ou fichier -->
                                    <ContentControl Grid.Column="0" Margin="0,0,8,0" Width="16" Height="16">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Tag" Value="{StaticResource Ico.Folder}" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                        <Setter Property="Tag" Value="{StaticResource Ico.File}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                    <TextBlock Grid.Column="1" beh:TextHighlight.Text="{Binding Label}" beh:TextHighlight.Query="{Binding HighlightTerm}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <!-- États : DFS / LIEN (étiquettes), audit incomplet (pastille) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Background="Transparent" ToolTip="{Binding StateTooltip}">
                                        <Border Style="{StaticResource NodeTag}" Visibility="{Binding IsDfsLink, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{l:Loc Scan_DfsTag}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource NodeTag}" Visibility="{Binding IsReparseLink, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{l:Loc Scan_LinkTag}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Alert}" Width="14" Height="14" Margin="6,0,0,0"
                                                        Foreground="{DynamicResource WarningMarkBrush}"
                                                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                               Foreground="{DynamicResource TertiaryBrush}" Margin="12,0,6,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasSize, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="row" CornerRadius="6" Background="Transparent" Margin="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander" Grid.Column="0" Style="{StaticResource ExpandToggle}"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                                        <ContentPresenter Grid.Column="1" ContentSource="Header" />
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" Visibility="Collapsed" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Border>

                <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns" DragCompleted="OnSplitterDragCompleted" />

                <!-- Détail -->
                <Grid Grid.Column="2" Background="{DynamicResource BgBrush}">
                    <!-- Aucun élément sélectionné -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedFolder}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Folder}" Width="28" Height="28"
                                        Foreground="{DynamicResource TertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{l:Loc Scan_SelectFolder}" Style="{StaticResource T.Secondary}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <DockPanel Margin="24,20,24,20" Visibility="{Binding HasSelectedFolder, Converter={StaticResource BoolToVis}}">
                        <!-- En-tête de l'élément -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                <ContentControl Width="18" Height="18">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Tag" Value="{StaticResource Ico.Folder}" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIsFile}" Value="True">
                                                    <Setter Property="Tag" Value="{StaticResource Ico.File}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding SelectedFolderName}" Style="{StaticResource T.Title}" FontSize="17" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedFolderRelativePath}" ToolTip="{Binding SelectedFolderPath}" Style="{StaticResource T.MonoMuted}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedFolderSummary}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- États particuliers (ACL illisible, contenu non listable, lien DFS…) -->
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SelectedFolderStates}" Margin="0,0,0,8"
                                      ItemTemplate="{StaticResource StateCallout}"
                                      Visibility="{Binding HasSelectedFolderStates, Converter={StaticResource BoolToVis}}" />

                        <!-- Table des droits -->
                        <Border Style="{StaticResource Table}" VerticalAlignment="Top"
                                Visibility="{Binding HasSelectedAcl, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource Table.Head}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.9*" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColType}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColIdentity}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColRights}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColScope}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColInherit}" />
                                    </Grid>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding SelectedAcl}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Table.Row}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <Grid MinHeight="44">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="104" />
                                                                <ColumnDefinition Width="1.8*" />
                                                                <ColumnDefinition Width="1.3*" />
                                                                <ColumnDefinition Width="1.9*" />
                                                                <ColumnDefinition Width="104" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentControl Grid.Column="0" Style="{StaticResource AceTypeBadge}" Content="{Binding TypeText}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8,12,8">
                                                                <TextBlock Text="{Binding Identity}" ToolTip="{Binding Identity}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <Button Style="{StaticResource LinkButton}" Command="{Binding ToggleMembersCommand}" Margin="0,2,0,0"
                                                                        FontSize="12" Content="{Binding MembersLinkText}"
                                                                        Visibility="{Binding HasMembers, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding RightsFr}" VerticalAlignment="Center" Margin="0,8,12,8" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="3" Text="{Binding ScopeFr}" Style="{StaticResource T.Secondary}" VerticalAlignment="Center"
                                                                       Margin="0,8,12,8" TextWrapping="Wrap" />
                                                            <!-- Héritage : lien vers la source, ou pastille « Explicite » -->
                                                            <Grid Grid.Column="4" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource LinkButton}" Command="{Binding ToggleSourceCommand}"
                                                                        FontSize="12.5" Content="{Binding InheritedText}" HorizontalAlignment="Left"
                                                                        Visibility="{Binding IsInherited, Converter={StaticResource BoolToVis}}" />
                                                                <ContentControl Content="{Binding InheritedText}">
                                                                    <ContentControl.Style>
                                                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Badge.Accent}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ContentControl.Style>
                                                                </ContentControl>
                                                            </Grid>
                                                        </Grid>

                                                        <!-- Membres du groupe -->
                                                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                Margin="104,0,0,12" Padding="12,9" CornerRadius="6"
                                                                Visibility="{Binding IsMembersExpanded, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel>
                                                                <ItemsControl ItemsSource="{Binding MemberPreview}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.User}" Width="12" Height="12"
                                                                                                Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,8,0" />
                                                                                <TextBlock Text="{Binding}" Style="{StaticResource T.MonoMuted}" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{Binding MoreMembersText}" Style="{StaticResource T.Caption}" Margin="20,4,0,0"
                                                                           Visibility="{Binding HasMoreMembers, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Source de l'héritage -->
                                                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                Margin="104,0,0,12" Padding="12,9" CornerRadius="6"
                                                                Visibility="{Binding IsSourceExpanded, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding InheritedFromLabel}" Style="{StaticResource T.Label}" Margin="0,0,0,3" />
                                                                <TextBlock Text="{Binding SourcePath}" Style="{StaticResource T.MonoMuted}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- ───── Vue Identités ───── -->
            <Grid Visibility="{Binding IsIdentitiesView, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IdentitiesPaneColumn" Width="340" MinWidth="240" MaxWidth="640" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Maître : liste d'identités -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding IdentitiesCountText}" Style="{StaticResource T.Label}" Margin="18,14,18,8" />
                        <ListBox ItemsSource="{Binding Identities}" SelectedItem="{Binding SelectedIdentity}"
                                 ItemContainerStyle="{StaticResource IdentityItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Margin="0,0,10,0">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Tag" Value="{StaticResource Ico.User}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroupLike}" Value="True">
                                                            <Setter Property="Tag" Value="{StaticResource Ico.Users}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock Grid.Column="1" Text="{Binding Identity}" ToolTip="{Binding Identity}" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding FolderCount}" Style="{StaticResource T.Caption}" FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns" DragCompleted="OnSplitterDragCompleted" />

                <!-- Détail identité -->
                <Grid Grid.Column="2" Background="{DynamicResource BgBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedIdentity}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Users}" Width="28" Height="28"
                                        Foreground="{DynamicResource TertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{l:Loc Scan_SelectIdentity}" Style="{StaticResource T.Secondary}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <DockPanel Margin="24,20" DataContext="{Binding SelectedIdentityDetail}"
                               Visibility="{Binding DataContext.HasSelectedIdentity, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <!-- En-tête -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                <ContentControl Width="18" Height="18">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Tag" Value="{StaticResource Ico.User}" />
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroupLike}" Value="True">
                                                    <Setter Property="Tag" Value="{StaticResource Ico.Users}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Identity}" Style="{StaticResource T.Title}" FontSize="17" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource Badge}" Content="{Binding TypeText}" Margin="10,1,0,0" Visibility="{Binding HasTypeText, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource T.Caption}">
                                    <Run Text="{Binding PresentOnText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Membres du groupe -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,0,0,16"
                                Visibility="{Binding HasMembers, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource Table.Head}">
                                    <TextBlock Style="{StaticResource T.Th}" Text="{Binding MembersCountText}" />
                                </Border>
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Members}" Margin="12,10,12,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource Badge}" Content="{Binding}" Tag="{StaticResource Ico.User}" Margin="0,0,6,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Emplacements (table paginée) -->
                        <Border Style="{StaticResource Table}" Visibility="{Binding HasLocations, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource Table.Head}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColPath}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColType}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColRights}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColScope}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource T.Th}" Text="{l:Loc Scan_ColInherit}" />
                                    </Grid>
                                </Border>

                                <!-- Pagination -->
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Table.Foot}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RangeText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{l:Loc Scan_PerPage}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox Width="74" ItemsSource="{x:Static vm:IdentityDetailViewModel.PageSizes}" SelectedItem="{Binding PageSize}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.Icon}" Command="{Binding PrevPageCommand}" ToolTip="{l:Loc Scan_PrevPage}">
                                                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.ChevronLeft}" />
                                            </Button>
                                            <Button Style="{StaticResource Btn.Icon}" Command="{Binding NextPageCommand}" ToolTip="{l:Loc Scan_NextPage}" Margin="2,0,0,0">
                                                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.ChevronRight}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding Locations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Table.Row}">
                                                    <Grid MinHeight="44">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.2*" />
                                                            <ColumnDefinition Width="104" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="1.7*" />
                                                            <ColumnDefinition Width="96" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentControl Width="14" Height="14" Margin="0,0,8,0">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource Icon}">
                                                                        <Setter Property="Tag" Value="{StaticResource Ico.Folder}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                                                <Setter Property="Tag" Value="{StaticResource Ico.File}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                            <TextBlock Grid.Column="1" Text="{Binding RelativePath}" ToolTip="{Binding FullPath}" Style="{StaticResource T.Mono}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <ContentControl Grid.Column="1" Style="{StaticResource AceTypeBadge}" Content="{Binding TypeText}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding RightsFr}" VerticalAlignment="Center" Margin="0,8,12,8" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ScopeFr}" Style="{StaticResource T.Secondary}" VerticalAlignment="Center"
                                                                   Margin="0,8,12,8" TextWrapping="Wrap" />
                                                        <Grid Grid.Column="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InheritedText}" Style="{StaticResource T.Secondary}"
                                                                       Visibility="{Binding IsInherited, Converter={StaticResource BoolToVis}}" />
                                                            <ContentControl Content="{Binding InheritedText}">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl" BasedOn="{StaticResource Badge.Accent}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
