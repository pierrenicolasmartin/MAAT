<Window x:Class="MAAT.App.Views.AuditReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MAAT.App.Controls"
        xmlns:l="clr-namespace:MAAT.App.Localization"
        Title="{l:Loc Rep_WinTitle}"
        Height="720" Width="940" MinHeight="520" MinWidth="740"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/MAAT.App;component/Assets/maat.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Verdict : pastille selon l'état (défaut : observations) -->
        <Style x:Key="VerdictBadge" TargetType="ContentControl" BasedOn="{StaticResource Badge.Warning}">
            <Setter Property="Tag" Value="{StaticResource Ico.Alert}" />
            <Setter Property="FontSize" Value="12.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="success">
                    <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="Tag" Value="{StaticResource Ico.CheckCircle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="error">
                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="Tag" Value="{StaticResource Ico.Ban}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tuile de signal : contour et icône selon le ton -->
        <Style x:Key="SignalCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="alert">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SignalIcon" TargetType="ContentControl" BasedOn="{StaticResource Icon}">
            <Setter Property="Tag" Value="{StaticResource Ico.Info}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="alert">
                    <Setter Property="Tag" Value="{StaticResource Ico.Ban}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Tag" Value="{StaticResource Ico.Alert}" />
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Tag" Value="{StaticResource Ico.CheckCircle}" />
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SignalNumber" TargetType="TextBlock" BasedOn="{StaticResource T.Metric}">
            <Setter Property="FontSize" Value="22" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="alert">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Motif d'un élément non audité : rouge (refus / erreur), ambre sinon -->
        <Style x:Key="ReasonBadge" TargetType="ContentControl" BasedOn="{StaticResource Badge.Warning}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeRed}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═════════ En-tête ═════════ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22,28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Top">
                    <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Report}" Width="20" Height="20"
                                    Foreground="{DynamicResource MutedBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc Rep_Label}" Style="{StaticResource T.PageTitle}" FontSize="19" />
                    <TextBlock Text="{Binding RootPath}" ToolTip="{Binding RootPath}" Style="{StaticResource T.MonoMuted}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding FinishedText, Mode=OneWay}" /><Run Text="   ·   " Foreground="{DynamicResource BorderStrongBrush}" /><Run Text="{Binding DurationText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <ContentControl Grid.Column="2" Style="{StaticResource VerdictBadge}" Content="{Binding VerdictText}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═════════ Pied ═════════ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Lock}" Width="13" Height="13"
                                        Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{l:Loc Rep_Confidential}" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExportMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="12"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExportMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExportMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Secondary}" Content="{l:Loc Rep_ExportLog}" ui:Ui.Icon="{StaticResource Ico.Download}"
                            Command="{Binding ExportLogCommand}" />
                    <Button Content="{l:Loc Common_Close}" MinWidth="96" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════ Corps ═════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="28,22,28,28">
                <!-- Périmètre couvert -->
                <TextBlock Text="{l:Loc Rep_Covered}" Style="{StaticResource T.Section}" Margin="0,0,0,10" />
                <Border Style="{StaticResource Panel}" Padding="4,14">
                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="16,0">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource T.Metric}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Points d'attention -->
                <TextBlock Text="{l:Loc Rep_Signals}" Style="{StaticResource T.Section}" Margin="0,24,0,5"
                           Visibility="{Binding HasSignals, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Signals}" Margin="-5,0"
                              Visibility="{Binding HasSignals, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding SignalColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SignalCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource SignalIcon}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Number}" Style="{StaticResource SignalNumber}" VerticalAlignment="Top"
                                               Margin="10,-3,0,0" Visibility="{Binding HasNumber, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Éléments non audités -->
                <Grid Margin="0,24,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Rep_Issues}" Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                        <ContentControl Style="{StaticResource Badge}" Content="{Binding CountItemsText}" />
                        <ContentControl Content="{Binding CountErrorsText}" Margin="6,0,0,0">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource Badge.Danger}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorsClean}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <ContentControl Style="{StaticResource Badge.Warning}" Content="{Binding CountWarnsText}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{l:Loc Rep_IssuesExplain}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap"
                           Margin="0,0,0,12" MaxWidth="760" HorizontalAlignment="Left"
                           Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}" />

                <ContentControl Style="{StaticResource Callout.Success}" Margin="0,6,0,0"
                                Visibility="{Binding NoIssues, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{l:Loc Rep_AllAudited}" TextWrapping="Wrap" />
                </ContentControl>

                <Border Style="{StaticResource Table}" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource Table.Head}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource T.Th}" Text="{l:Loc Rep_Col_Reason}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource T.Th}" Text="{l:Loc Rep_Col_Path}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource T.Th}" Text="{l:Loc Rep_Col_Severity}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Table.Row}" MinHeight="40">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Grid.Column="0" Style="{StaticResource ReasonBadge}" Content="{Binding Reason}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" ToolTip="{Binding Path}" Style="{StaticResource T.Mono}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding SeverityText}" Style="{StaticResource T.Secondary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Btn.Subtle}" HorizontalAlignment="Stretch" MinHeight="40"
                                Foreground="{DynamicResource AccentTextBrush}" Content="{Binding RemainingText}"
                                ui:Ui.Icon="{StaticResource Ico.ChevronDown}" Command="{Binding ShowAllCommand}"
                                Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
