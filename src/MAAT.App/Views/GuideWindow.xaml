<Window x:Class="MAAT.App.Views.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MAAT.App.Localization"
        Title="{l:Loc Guide_WinTitle}"
        Height="700" Width="1000" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/MAAT.App;component/Assets/maat.ico"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Entrée du sommaire -->
        <Style x:Key="TocItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="num" Text="{Binding Number}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                           Foreground="{DynamicResource TertiaryBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock x:Name="ttl" Grid.Column="1" Text="{Binding Title}" FontFamily="{StaticResource Font.Sans}" FontSize="13"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                <Setter TargetName="ttl" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                <Setter TargetName="num" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="ttl" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="ttl" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═════════ Sommaire ═════════ -->
        <Border Grid.Column="0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Book}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{l:Loc Guide_HdrTitle}" Style="{StaticResource T.Title}" />
                    </StackPanel>
                    <!-- Recherche -->
                    <Border Height="32" CornerRadius="6" BorderThickness="1" Padding="10,0" Margin="0,14,0,0"
                            Background="{DynamicResource SurfaceBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.Search}" Width="14" Height="14"
                                            Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,8,0" />
                            <Grid Grid.Column="1">
                                <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{l:Loc Guide_Search}" Foreground="{DynamicResource TertiaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
                <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" Padding="12,0,12,12"
                         ItemContainerStyle="{StaticResource TocItem}" />
            </DockPanel>
        </Border>

        <!-- ═════════ Contenu ═════════ -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Secondary}" Width="34" Padding="0" IsEnabled="{Binding CanPrev}" Command="{Binding PrevCommand}"
                                ToolTip="{l:Loc Guide_Prev}">
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.ChevronLeft}" />
                        </Button>
                        <TextBlock Text="{Binding Pagination}" Style="{StaticResource T.Caption}" FontFamily="{StaticResource Font.Mono}"
                                   VerticalAlignment="Center" Margin="12,0" MinWidth="48" TextAlignment="Center" />
                        <Button Style="{StaticResource Btn.Secondary}" Width="34" Padding="0" IsEnabled="{Binding CanNext}" Command="{Binding NextCommand}"
                                ToolTip="{l:Loc Guide_Next}">
                            <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource Ico.ChevronRight}" />
                        </Button>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="{l:Loc Common_Close}" MinWidth="96" IsCancel="True" Click="OnClose" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel DataContext="{Binding SelectedTopic}" Margin="44,34,44,40" MaxWidth="700" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DetailKicker}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.PageTitle}" FontSize="24" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Intro}" FontSize="14.5" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"
                               TextWrapping="Wrap" LineHeight="23" />

                    <ItemsControl ItemsSource="{Binding Sections}" Margin="0,18,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" Style="{StaticResource T.Section}" FontSize="14.5" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Body}" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" LineHeight="21" />
                                        <ContentControl x:Name="note" Style="{StaticResource Callout.Info}" Margin="0,12,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="{l:Loc Guide_Note}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap" LineHeight="20" />
                                            </StackPanel>
                                        </ContentControl>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasNote}" Value="True">
                                        <Setter TargetName="note" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
