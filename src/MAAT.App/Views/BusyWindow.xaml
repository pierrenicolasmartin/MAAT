<Window x:Class="MAAT.App.Views.BusyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MAAT.App.Localization"
        Title="MAAT" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource Font.Sans}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <!-- Carte flottante (marge : place de l'ombre portée) -->
    <Border Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Effect="{DynamicResource ShadowPopup}">
        <StackPanel>
            <StackPanel Margin="22,20,22,18">
                <!-- Indicateur d'état + titre / message -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,12,0">
                        <!-- Pendant le travail : anneau accent -->
                        <Grid x:Name="Ring">
                            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" />
                        </Grid>
                        <!-- Terminé : coche -->
                        <ContentControl x:Name="DoneDot" Style="{StaticResource Icon}" Tag="{StaticResource Ico.CheckCircle}"
                                        Width="20" Height="20" Foreground="{DynamicResource SuccessBrush}" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TitleText" Style="{StaticResource T.Section}" FontSize="14" Text="Export en cours" />
                        <TextBlock x:Name="MessageText" Style="{StaticResource T.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="{l:Loc Busy_Wait}" />
                    </StackPanel>
                </Grid>

                <!-- Barre indéterminée (pendant le travail) -->
                <ProgressBar x:Name="Bar" Height="4" Margin="32,16,0,0" IsIndeterminate="True" />

                <!-- Fichier produit (une fois terminé) -->
                <Border x:Name="DonePathBox" Margin="32,12,0,0" Padding="10,7" CornerRadius="6"
                        Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding Visibility, ElementName=DonePath}">
                    <TextBlock x:Name="DonePath" Style="{StaticResource T.MonoMuted}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </Border>
            </StackPanel>

            <!-- Actions : Annuler (pendant) puis Ouvrir / Fermer (terminé) -->
            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Padding="22,12">
                <Grid>
                    <StackPanel x:Name="CancelRow" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelBtn" Content="{l:Loc Common_Cancel}" Style="{StaticResource Btn.Secondary}" Click="OnCancel" />
                    </StackPanel>
                    <StackPanel x:Name="DoneButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button x:Name="IgnoreBtn" Content="{l:Loc Common_Close}" Style="{StaticResource Btn.Secondary}" Click="OnIgnore" />
                        <Button x:Name="OpenBtn" Content="{l:Loc Busy_Open}" Margin="8,0,0,0" Click="OnOpen" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
