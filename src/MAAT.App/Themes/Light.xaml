<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ════════════════════════════════════════════════════════════
         MAAT 1.3 — Palette CLAIRE
         Neutres froids, surfaces blanches, un seul accent : bleu lapis
         (couleur de l'iconographie de Maât ; bleu = confiance). Les
         couleurs sémantiques (autoriser / refuser / avertir) ne servent
         qu'à porter du sens, jamais à décorer.
         Les CLÉS sont communes à Dark.xaml (bascule à chaud).
         ════════════════════════════════════════════════════════════ -->

    <!-- ── Surfaces ── -->
    <Color x:Key="BgColor">#F4F5F7</Color>          <!-- fond d'application -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>     <!-- panneaux, barres, cartes -->
    <Color x:Key="Surface2Color">#F7F8FA</Color>    <!-- en-têtes de tableau, encarts -->
    <Color x:Key="Surface3Color">#EDEFF3</Color>    <!-- survol / pressé neutre, piste -->
    <Color x:Key="BorderColor">#E2E5EA</Color>      <!-- filet -->
    <Color x:Key="BorderStrongColor">#CBD0D8</Color><!-- contour de contrôle -->

    <!-- ── Texte ── -->
    <Color x:Key="TextColor">#14171D</Color>
    <Color x:Key="MutedColor">#4E5766</Color>
    <Color x:Key="TertiaryColor">#667080</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="TooltipBgColor">#1D222B</Color>
    <Color x:Key="TooltipTextColor">#F2F4F7</Color>

    <!-- ── Accent (lapis) ── -->
    <Color x:Key="AccentColor">#2457C5</Color>
    <Color x:Key="AccentHoverColor">#1E4AAB</Color>
    <Color x:Key="AccentPressedColor">#193F92</Color>
    <Color x:Key="AccentTintColor">#EDF2FC</Color>  <!-- sélection, survol accentué -->
    <Color x:Key="AccentTint2Color">#D9E4F9</Color> <!-- sélection appuyée -->
    <Color x:Key="AccentTextColor">#1E4AAB</Color>  <!-- texte accent sur fond teinté -->

    <!-- ── Sémantique ── -->
    <Color x:Key="SuccessColor">#1A7D4A</Color>
    <Color x:Key="SuccessTintColor">#E6F4EC</Color>
    <Color x:Key="DangerColor">#BF3A2C</Color>
    <Color x:Key="DangerTintColor">#FCECEA</Color>
    <Color x:Key="WarningColor">#9E6208</Color>
    <Color x:Key="WarningTintColor">#FCF3E2</Color>
    <Color x:Key="WarningMarkColor">#D18E1D</Color> <!-- pastilles / barres d'avertissement -->

    <!-- ── Brosses ── -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="TooltipBgBrush" Color="{StaticResource TooltipBgColor}" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="{StaticResource TooltipTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="AccentTint2Brush" Color="{StaticResource AccentTint2Color}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColor}" />
    <SolidColorBrush x:Key="WarningMarkBrush" Color="{StaticResource WarningMarkColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#592457C5" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B9DFC9" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F2C4BE" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#EFD5A6" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#BCCDF1" />

    <!-- ── Ombres (éléments flottants uniquement) ── -->
    <DropShadowEffect x:Key="ShadowPopup" Color="#0E1624" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.14" />
    <DropShadowEffect x:Key="ShadowRaised" Color="#0E1624" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.10" />

    <!-- ── Alias historiques (compatibilité des vues non migrées) ── -->
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DenyBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource WarningMarkColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="ProgressBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ProgressGreenBrush" Color="{StaticResource SuccessColor}" />
    <DropShadowEffect x:Key="GlowSoft" Color="#0E1624" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.14" />

    <!-- Logos pour fond clair : versions NOIRES (« dark ») -->
    <BitmapImage x:Key="LogoTexteImage" UriSource="pack://application:,,,/MAAT.App;component/Assets/logo_texte_dark.png" />
    <BitmapImage x:Key="LogoSymbolImage" UriSource="pack://application:,,,/MAAT.App;component/Assets/symbol_dark.png" />
</ResourceDictionary>
